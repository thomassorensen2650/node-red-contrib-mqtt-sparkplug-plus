{
  "name": "node-red-contrib-mqtt-sparkplug-plus",
  "version": "3.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomassorensen2650/node-red-contrib-mqtt-sparkplug-plus.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "description": "MQTT-Sparkplug-Plus is a set of Node-Red nodes, that will enable Node-Red to communicate with a MQTT Server using the sparkplug b protocol.",
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "mqtt-sparkplug-plus": "mqtt-sparkplug-plus.js"
    }
  },
  "files": [
    "mqtt-sparkplug-plus.js",
    "mqtt-sparkplug-plus.html",
    "locales/",
    "icons/",
    "examples/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "mocha --exit \"test/**/*_spec.js\"",
    "coverage": "nyc --reporter=lcov --reporter=text mocha --exit \"test/**/*_spec.js\"",
    "tck": "node test/tck/run-tck.js",
    "tck:broker": "test/tck/start-broker.sh"
  },
  "keywords": [
    "MQTT",
    "Sparkplug",
    "node-red"
  ],
  "author": "Thomas Sørensen",
  "license": "ISC",
  "dependencies": {
    "https-proxy-agent": "^7.0.2",
    "long": "^5.2.3",
    "mqtt": "^4.3.7",
    "pako": "^2.1.0",
    "protobufjs": "^7.2.5",
    "sparkplug-payload": "1.0.3"
  },
  "devDependencies": {
    "mocha": "^11.7.5",
    "node-red": "^3.1.3",
    "node-red-node-test-helper": "^0.3.3",
    "nyc": "^18.0.0"
  }
}
